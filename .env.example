# Wishka - environment variables.
# Copy to .env.dev for local development (git-ignored), or to .env on the server (never committed).
# Values below are dev examples for the existing dev containers (dev-postgres, dev-mailpit).

# --- Application -------------------------------------------------------------
# Product name shown to users. Never translated, referenced as {appName} / @:app.name.
APP_NAME=Wishka
# Absolute base URL for every generated link (emails, push, share links, OAuth redirects).
# Dev: the Vite dev server. Prod: https://wishka.pl
APP_BASE_URL=http://localhost:5173
# Backend HTTP port.
SERVER_PORT=8080
# Spring profile: dev (default when unset), prod on the server.
# SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL 17) -----------------------------------------------------
# Use 127.0.0.1 (not localhost): dev-postgres listens on IPv4 only.
# From a container on dev_network use jdbc:postgresql://dev-postgres:5432/wishka
DB_URL=jdbc:postgresql://127.0.0.1:5432/wishka
DB_USER=wishka
DB_PASSWORD=change-me

# --- Email -------------------------------------------------------------------
# Dev: dev-mailpit (SMTP 1025, UI http://127.0.0.1:8025). Prod: transactional provider (D-29, chosen before release).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@wishka.pl

# --- Storage -----------------------------------------------------------------
# Downloaded/resized item images (Phase 2). The Docker image uses /data/images (a volume).
IMAGE_STORAGE_PATH=./data/images

# --- Frontend dev server -------------------------------------------------------
# Where the Vite dev server proxies /api (default http://localhost:8080).
# API_PROXY_TARGET=http://localhost:8080

# --- Google login (Phase 1) -----------------------------------------------------
# Optional: the "Continue with Google" button appears only when both are set.
# Google Cloud console -> OAuth client (Web application), authorised redirect URI:
#   ${APP_BASE_URL}/login/oauth2/code/google   (dev: http://localhost:5173/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notifications (Phase 1) -------------------------------------------------------
# How often the outbox dispatcher delivers pending notifications (ISO-8601 duration).
NOTIFICATIONS_DISPATCH_INTERVAL=PT2S

# --- Phase 6: Cloudflare Turnstile (dev uses Cloudflare's test keys) ----------------
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Phase 7: Web Push (VAPID) -------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@wishka.pl
