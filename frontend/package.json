{
  "name": "wishka-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write --experimental-cli src/ e2e/",
    "test:unit:watch": "vitest",
    "format:check": "prettier --check --experimental-cli src/ e2e/",
    "fix": "oxlint . --fix && eslint . --fix --cache",
    "test:unit:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/unit-junit.xml"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "jsonc-eslint-parser": "^3.3.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.4.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "yaml-eslint-parser": "^2.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
